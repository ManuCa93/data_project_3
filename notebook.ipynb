    "# Configure S3 once\n",
    "con = duckdb.connect(\"project.duckdb\")\n",
    "con.sql(\"INSTALL httpfs; LOAD httpfs;\")\n",
    "\n",
    "# Peek at structure\n",
    "con.sql(f\"DESCRIBE SELECT * FROM read_parquet('{PARQUET}')\").df()"
   ]
